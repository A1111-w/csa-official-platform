# Copy this file to .env for local development.
# Point the backend at your remote TiDB and Upstash instances so you do not
# need local MySQL or Redis running on your machine.

DB_URL=jdbc:mysql://<tidb-host>:4000/csa_db?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&sslMode=VERIFY_IDENTITY&enabledTLSProtocols=TLSv1.2
DB_USERNAME=<tidb-username>
DB_PASSWORD=<tidb-password>

# Keep the pool small for a lightweight local dev setup.
DB_MAX_POOL_SIZE=4
DB_MIN_IDLE=1

# Default to the in-process cache so local development does not need Redis at all.
CSA_CACHE_TYPE=memory

# Optional remote Redis. Set CSA_CACHE_TYPE=redis to use it.
REDIS_HOST=<redis-host>
REDIS_PORT=6379
REDIS_PASSWORD=<upstash-token>
REDIS_SSL=true

# Required for login/token generation. Use at least 32 characters.
JWT_SECRET=<replace-with-a-long-random-secret>

# Optional for registration email. Leave blank if you do not need send-code.
MAIL_USERNAME=<your-smtp-account@example.com>
MAIL_PASSWORD=

# Optional overrides.
SERVER_PORT=8080
FORWARD_HEADERS_STRATEGY=framework
JWT_EXPIRATION=604800000
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_FORWARDED_IP_HEADER=X-Forwarded-For
RATE_LIMIT_TRUSTED_PROXIES=127.0.0.1
UPLOAD_PATH=
MAX_FILE_SIZE=50MB
MAX_REQUEST_SIZE=50MB
UPLOAD_MAX_FILE_SIZE_BYTES=52428800
UPLOAD_USER_QUOTA_BYTES=209715200
UPLOAD_SCHOOL_QUOTA_BYTES=21474836480
UPLOAD_ORPHAN_GRACE_HOURS=24
UPLOAD_CLEANUP_BATCH_SIZE=100
PRIVACY_POLICY_VERSION=2026-01
PRIVACY_CONTACT_EMAIL=privacy@localhost.invalid
ACCOUNT_DELETION_RETENTION_DAYS=30
MAIL_MAX_ATTEMPTS=3
SCHEDULED_JOB_LOCK_SECONDS=900
FLYWAY_ENABLED=true
FLYWAY_LOCATIONS=classpath:db/migration
FLYWAY_BASELINE_ON_MIGRATE=false
GIT_ALLOWED_HOSTS=github.com,gitee.com,gitlab.com
AUTH_COOKIE_NAME=CSA_AUTH_TOKEN
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
# Production deployments must also set:
# SPRING_PROFILES_ACTIVE=production
# AUTH_COOKIE_SECURE=true
# For cross-site deployments, use exact frontend origins in CORS_ALLOWED_ORIGIN_PATTERNS
# and set AUTH_COOKIE_SECURE=true plus AUTH_COOKIE_SAME_SITE=None.
CSRF_ENABLED=true
CSRF_COOKIE_NAME=CSA_CSRF_TOKEN
CSRF_HEADER_NAME=X-CSRF-Token
